# Only enter the real token in your hosting variables or local .env.
DISCORD_TOKEN=
GUILD_ID=

# Railway: koppel een volume aan /data
DATA_DIR=/data

# Optioneel eigen HTTPS-domein. Railway gebruikt automatisch RAILWAY_PUBLIC_DOMAIN.
# Genereer eerst een publiek domein bij Settings > Networking > Generate Domain.
# TRANSCRIPT_BASE_URL=https://jouw-bot.up.railway.app
# PORT=3000

# Discord OAuth2-login voor de logwebsite (niet de bottoken).
LOGSITE_BASE_URL=https://la-noche-logs.nl
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Discord Developer Portal > OAuth2 > Redirects:
# https://la-noche-logs.nl/auth/discord/callback
